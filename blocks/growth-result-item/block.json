{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "wooapb/growth-result-item",
    "version": "1.0.0",
    "title": "Result Item",
    "category": "design",
    "icon": "chart-line",
    "parent": [
        "wooapb/business-growth-results"
    ],
    "description": "Single result card.",
    "supports": {
        "html": false,
        "reusable": false
    },
    "attributes": {
        "amount": {
            "type": "string",
            "default": "$300MM"
        },
        "suffix": {
            "type": "string",
            "default": "/yr brand"
        },
        "growth": {
            "type": "string",
            "default": "+47% revenue YOY, -31% CAC"
        },
        "description": {
            "type": "string",
            "default": "Channel and site tuned to work together"
        }
    },
    "editorScript": "file:../../build/growth-result-item/index.js"
}